# Claude Code local settings (machine-specific; shared settings.json is fine to commit)
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Secrets / env
.env
.env.*
*.key
*.pem

# Dependencies
node_modules/

# electron-vite build output
out/

# electron-builder packaged output
release/

# TypeScript incremental build info
*.tsbuildinfo

# Common build/dependency output (harmless if unused)
dist/
__pycache__/
*.pyc
venv/
.venv/

# Real drawing sets dropped in the repo for testing - never commit these
# (GitHub rejects files over 100MB, and these are working files, not source)
*.pdf

# Scratch projects created while testing the app by hand. The PDFs inside are
# already ignored above, but their .manifest/*.json would otherwise be
# committed - and they are throwaway working state, not source.
#
# Listed individually on purpose: git on Windows matches ignore patterns
# case-insensitively, so a glob like /Test*/ also swallows the source `test/`
# directory and silently drops the whole suite from the repo.
/Test1/
/Test2/
/Test3/

# Generated by scripts/copy-pdfjs-assets.mjs - version-locked copies of
# pdf.js runtime assets (wasm codecs, cMaps, standard fonts). Never commit
# these; they must track the installed pdfjs-dist.
/src/renderer/public/
